{
  "name": "r2-backup-console",
  "version": "0.1.0",
  "private": true,
  "description": "Bounded native Worker backup console with a pinned Explorer dashboard and Cloudflare Access JWT enforcement",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit --allowImportingTsExtensions",
    "test": "node --test --test-timeout=120000 test/*.test.mjs",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261101.1",
    "typescript": "7.0.2",
    "wrangler": "4.156.1"
  }
}
