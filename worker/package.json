{
  "name": "r2-backup-console",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker web console (R2-Explorer) for the backup bucket, with Cloudflare Access JWT enforcement",
  "license": "MIT",
  "type": "module",
  "engines": {
    "npm": ">=11.19.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.19.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "r2-explorer": "1.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261101.1",
    "typescript": "7.0.2",
    "wrangler": "4.156.1"
  }
}
