# Copy to ~/.config/paperclip-r2-backup/env (mode 0600). Placeholders only.
# systemd EnvironmentFile format: KEY=value, no "export", no quotes. No %h or $VAR expansion; use ~/ (the script expands it).

# --- rclone remote "R2", defined through environment (values are never logged)
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ACCESS_KEY_ID=<r2-access-key-id>
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
RCLONE_CONFIG_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true

# --- backup settings
BACKUP_BUCKET=<bucket-name>
PAPERCLIP_BACKUP_DIR=~/.paperclip/instances/default/data/backups
PAPERCLIP_INSTANCE_DIR=~/.paperclip/instances/default
# --- consistent custom-format snapshots for BOTH databases
# Enable only after Operator configures the existing libpq service/pass file and
# pre-pulls reviewed, compatible digest-pinned restore images. No new credentials.
SNAPSHOT_BACKUPS=true
PAPERCLIP_DB_NAME=paperclip
PAPERCLIP_PG_SERVICE=paperclip-backup
# PGSERVICEFILE=~/.config/paperclip-r2-backup/pg_service.conf
# PGPASSFILE=~/.config/paperclip-r2-backup/pgpass
PAPERCLIP_HEAD_TABLE=drizzle.__drizzle_migrations
PAPERCLIP_HEAD_COLUMNS=hash,created_at
PAPERCLIP_RESTORE_IMAGE=postgres:<compatible-major>@sha256:<reviewed-digest>
HINDSIGHT_DB_NAME=hindsight
HINDSIGHT_DB_CONTAINER=hindsight-db
HINDSIGHT_HEAD_TABLE=public.alembic_version
HINDSIGHT_HEAD_COLUMNS=version_num
HINDSIGHT_RESTORE_IMAGE=pgvector/pgvector:<compatible-pg18-tag>@sha256:<reviewed-digest>
# Sunday UTC, as part of the EXISTING daily backup timer. No second timer.
RESTORE_WEEKDAY=6
# Safe small-fixture defaults only. Operator must admit measured live capacity:
# expanded DB + indexes + WAL must fit data tmpfs; data + PostgreSQL must fit memory.
# Never raise these beyond existing host headroom or authorize new spend here.
RESTORE_DATA_MB=1024
RESTORE_MEMORY_MB=2048
RESTORE_RECEIPT_DIR=~/.local/state/paperclip-r2-backup/receipts
# Both images must supply every installed source extension. See docs/restore.md.
# Hard stop for managed prefixes (db/, instance/, paperclip/, hindsight/, status/).
# The check uses the PROJECTED size (current + incoming - objects retention will
# delete this run), so retention can bring usage back under the cap.
BACKUP_CAP_BYTES=10000000000
# SIZING WARNING: at ~0.25 GB per dump (growing), 30 daily + 12 weekly + 12 monthly
# dumps is roughly 40 objects, i.e. 10+ GB, which does NOT fit the 10 GB free tier.
# 30 days of dumps alone is ~7.5 GB. With the cap at 10 GB the tool stops uploading
# (exit 2, status ok=false) instead of spending money. Either approve R2 spend and
# raise BACKUP_CAP_BYTES, or lower these values.
RETAIN_DAILY=30
RETAIN_WEEKLY=12
RETAIN_MONTHLY=12
# instance/ snapshots (about 0.9 GB each) default to a much shorter history
#INSTANCE_RETAIN_DAILY=7
#INSTANCE_RETAIN_WEEKLY=4
#INSTANCE_RETAIN_MONTHLY=3
# Include secrets/ (master key) in the instance snapshot. Leave false: the key
# belongs in your password manager, not next to the data it protects.
INCLUDE_SECRETS=false
# Safety valve: steady state needs about 1 delete per prefix per day. A bad clock
# can then never wipe history in one or two runs. Raise temporarily to drain a backlog.
MAX_DELETES_PER_RUN=4
